# ============================================================
# GOTU Intelligence Platform — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ─── Server ──────────────────────────────────────────────────
PORT=4000
HOST=127.0.0.1
NODE_ENV=production
LOG_LEVEL=info

# ─── Data directory ──────────────────────────────────────────
# Where the database and salt files are stored.
DATA_DIR=./data

# ─── Encryption keys (REQUIRED in production) ────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# AES-256-GCM key for sensitive DB columns (64 hex chars = 32 bytes)
GOTU_ENCRYPTION_KEY=

# HMAC-SHA256 key for audit log integrity (64 hex chars = 32 bytes)
GOTU_AUDIT_HMAC_KEY=

# Session secret (at least 32 random chars)
GOTU_SESSION_SECRET=

# ─── Session ─────────────────────────────────────────────────
SESSION_TTL_SECONDS=86400

# ─── Rate limiting ───────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── MFA ─────────────────────────────────────────────────────
# Set to 'true' to require MFA for all users
MFA_REQUIRED=false

# ─── Job Queue ───────────────────────────────────────────────
JOB_LEASE_DURATION_MS=60000
JOB_HEARTBEAT_INTERVAL_MS=15000
JOB_REAPER_INTERVAL_MS=30000
JOB_MAX_CONCURRENT=3

# ============================================================
# INTELLIGENCE ENGINE API KEYS (all optional)
# Engines degrade gracefully when keys are absent.
# ============================================================

# GitHub (optional — increases rate limit from 60/hr to 5000/hr)
# No cost. Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Google Custom Search Engine
# Free: 100 queries/day. $5.00 per 1000 above that.
# Setup: https://programmablesearchengine.google.com/
# Note: CSE is NOT full Google Search — dork support is limited.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Brave Search API
# Prepaid credits. Free: ~$5/month (~1,000 requests at $5.00/1000).
# 50 req/sec. Sign up: https://api.search.brave.com/
BRAVE_SEARCH_KEY=

# Have I Been Pwned — email breach lookup (NOT password checks)
# Paid: ~$3.50/month. https://haveibeenpwned.com/API/Key
# GOTU uses this for email breach lookup ONLY.
# Pwned Passwords is NOT used — GOTU never touches passwords.
HIBP_API_KEY=

# X (Twitter) API — Basic tier ($100/mo) for profile lookup
TWITTER_API_KEY=

# Google API key for YouTube channel lookup
GOOGLE_API_KEY=

# OpenCorporates — business registry (free for open data)
# https://opencorporates.com/api_docs
OPENCORPORATES_API_KEY=

# Companies House UK (free, requires key)
# https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# CourtListener (optional — increases rate limit)
# https://www.courtlistener.com/sign-in/
COURTLISTENER_API_KEY=

# TinEye reverse image search (commercial, no confirmed free tier)
# https://tineye.com/api
TINEYE_API_KEY=

# Shodan (optional, freemium)
# https://account.shodan.io/
SHODAN_API_KEY=

# Meta Ad Library — requires Facebook OAuth access token
# https://developers.facebook.com/docs/graph-api/reference/ads_archive/
META_ACCESS_TOKEN=
